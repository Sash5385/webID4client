{
  "rules": {
    "admins": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "timeslots": {
      ".read": true,
      ".write": "auth != null",
      "$date": {
        "$slotId": {
          "vipOnly":       { ".validate": "root.child('admins').child(auth.uid).exists() || newData.val() === data.val()" },
          "adminBlocked":  { ".validate": "root.child('admins').child(auth.uid).exists() || newData.val() === data.val()" },
          "privateOnly":   { ".validate": "root.child('admins').child(auth.uid).exists() || newData.val() === data.val()" },
          "surcharge":     { ".validate": "root.child('admins').child(auth.uid).exists() || newData.val() === data.val()" },
          "fixedPrice":    { ".validate": "root.child('admins').child(auth.uid).exists() || newData.val() === data.val()" },
          "lunchOverride": { ".validate": "root.child('admins').child(auth.uid).exists() || newData.val() === data.val()" },
          "durMin":        { ".validate": "root.child('admins').child(auth.uid).exists() || newData.val() === data.val()" }
        }
      }
    },
    "bookings": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())"
      }
    },
    "queue": {
      "$slotKey": {
        "entries": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "userQueue": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())"
      }
    },
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        "customPrice": { ".validate": "root.child('admins').child(auth.uid).exists() || newData.val() === data.val()" }
      }
    },
    "chats": {
      "general": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())"
      }
    },
    "chatMeta": {
      "general": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())"
      }
    },
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "admin_data": {
      "services": {
        ".read": true,
        ".write": "auth != null"
      }
    },
    "admin_settings": {
      ".read": true,
      ".write": "auth != null"
    },
    "bookings_by_phone": {
      "$phone": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())"
      }
    },
    "reviews": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())"
      }
    }
  }
}
